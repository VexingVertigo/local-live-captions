/* Container HUD Card */
#OverlayCard {
    background-color: rgba(12, 12, 12, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 10px 18px;
}

/* Subtitle Caption Text */
#CaptionLabel {
    color: #f1f1f1;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    background: transparent;
    border: none;
}

/* Subtle Status Indicator */
#StatusLabel {
    color: #888888;
    font-size: 11px;
    font-weight: 500;
    text-align: right;
    background: transparent;
    border: none;
}